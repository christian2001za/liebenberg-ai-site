---
import BrandLayout from "../../layouts/BrandLayout.astro";
import "../../styles/content.css";
import HumanizerApp from "../../components/tools/HumanizerApp";
---

<BrandLayout
  title="AI Humanizer — Liebenberg AI"
  description="Gratis tool: plak AI-gegenereerde tekst en krijg een natuurlijkere, menselijkere versie terug. Geen account, geen e-mail."
  canonical="https://www.liebenberg.ai/tools/humanizer/"
>
  <main class="page page-wide">
    <div class="wrap">
      <div class="page-head">
        <a href="/tools/" class="back-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
          Tools
        </a>
        <h1>AI Humanizer.</h1>
        <p class="lead">Plak je AI-tekst, klik op humanize, klaar. De tool herkent typische AI-patronen — opgeblazen significantie, em-dashes, holle drielingen, vage attributies — en herschrijft ze naar iets dat klinkt als een mens die het zelf opschreef.</p>
      </div>

      <HumanizerApp client:load />
    </div>
  </main>
</BrandLayout>
