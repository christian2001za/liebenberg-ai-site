---
/**
 * Productvideo die vanzelf start zodra hij in beeld komt, in een lus en altijd zonder geluid.
 * Uit beeld pauzeert hij. Bij prefers-reduced-motion blijft de poster staan.
 */
interface Props { src: string; poster: string; width: number; height: number; label: string }
const { src, poster, width, height, label } = Astro.props;
---
<video class="auto-video" src={src} poster={poster} width={width} height={height} muted loop playsinline preload="metadata" disablepictureinpicture aria-label={label}></video>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLVideoElement>("video.auto-video").forEach((v) => {
    v.muted = true;
    if (reduce || !("IntersectionObserver" in window)) return;
    new IntersectionObserver(
      ([e]) => { if (e.isIntersecting) v.play().catch(() => {}); else v.pause(); },
      { threshold: 0.35 },
    ).observe(v);
  });
</script>
