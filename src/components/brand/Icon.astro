---
/** Icoon uit de eigen set (src/assets/huisstijl/icons). Alleen naast tekst gebruiken. */
import type { IconName } from "./icons";
const icons = import.meta.glob("../../assets/huisstijl/icons/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;


interface Props { name: IconName; class?: string }
const { name, class: cls = "ico" } = Astro.props;
const raw = icons[`../../assets/huisstijl/icons/${name}.svg`];
if (!raw) throw new Error(`Onbekend icoon: ${name}`);
const svg = raw
  .replace(/ width="24" height="24"/, "")
  .replace("<svg ", `<svg class="${cls}" aria-hidden="true" focusable="false" `);
---
<Fragment set:html={svg} />
