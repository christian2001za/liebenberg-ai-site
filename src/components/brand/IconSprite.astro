---
/** Eén keer per pagina: de iconen als <symbol>, zodat SVG-schema's ze met <use> kunnen tekenen. */
const icons = import.meta.glob("../../assets/huisstijl/icons/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const symbols = Object.entries(icons)
  .map(([path, raw]) => {
    const name = path.split("/").pop()!.replace(".svg", "");
    const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
    return `<symbol id="i-${name}" viewBox="0 0 24 24">${inner}</symbol>`;
  })
  .join("");
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" set:html={symbols} />
