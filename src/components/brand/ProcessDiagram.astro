---
/**
 * Processchema in de lijnstijl van de iconen: echte stappen, met de plek waar een mens beslist.
 * Stappen lopen van links naar rechts. tone "mens" = hier beslist een mens (amber),
 * tone "ok" = klaar (groen). Optioneel eindigt het schema in een splitsing (ja/nee).
 */
import type { IconName } from "./icons";

type Node = { icon: IconName; title: string; sub: string; tone?: "mens" | "ok" };
interface Props {
  label: string;
  steps: Node[];
  branch?: { cond: string; icon?: IconName; yes: Node; no: Node };
  note?: string;
}
const { label, steps, branch, note } = Astro.props;

// Breedte volgt de langste regel: mono 11px ≈ 6.7px per teken, sans 13px ≈ 7.2px.
const fit = (n: Node) => Math.max(n.sub.length * 6.7, n.title.length * 7.2) + 60;
const W = Math.max(176, ...steps.map(fit));
const BW = branch ? Math.max(220, fit(branch.yes), fit(branch.no)) : 0;
const H = 56, GAP = 44, X0 = 8;
const hasBranch = !!branch;
const height = hasBranch ? 240 : 120;
const cy = height / 2;
const nodes = steps.map((s, i) => ({ ...s, x: X0 + i * (W + GAP), y: cy - H / 2 }));
const lastX = nodes.length ? nodes[nodes.length - 1].x + W : X0;
const dx = lastX + GAP + 48; // middelpunt ruit
const outX = dx + 48 + 80;
const width = hasBranch ? outX + BW + 8 : lastX + 8;
const cls = (t?: string) => (t === "mens" ? "node warn" : t === "ok" ? "node ok" : "node");
const uid = `ah-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class="figure" style="margin:0">
  <svg class="diagram" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label} style={`min-width:${Math.round(Math.min(width, 1400) * 0.7)}px`}>
    <defs><marker id={uid} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path class="arrow" d="M0 0 8 4 0 8z" /></marker></defs>
    {nodes.map((n, i) => (
      <g>
        <rect class={cls(n.tone)} x={n.x} y={n.y} width={W} height={H} rx="8" />
        <use href={`#i-${n.icon}`} class="ic" x={n.x + 14} y={n.y + 18} width="20" height="20" />
        <text x={n.x + 44} y={n.y + 24}>{n.title}</text>
        <text class="m" x={n.x + 44} y={n.y + 42}>{n.sub}</text>
        {i < nodes.length - 1 && <path class="edge" d={`M${n.x + W} ${cy}h${GAP - 4}`} marker-end={`url(#${uid})`} />}
      </g>
    ))}
    {branch && (
      <g>
        <path class="edge" d={`M${lastX} ${cy}h${GAP - 4}`} marker-end={`url(#${uid})`} />
        <path class="node" d={`M${dx} ${cy - 48} ${dx + 48} ${cy} ${dx} ${cy + 48} ${dx - 48} ${cy}z`} />
        <use href={`#i-${branch.icon ?? "drempel"}`} class="ic" x={dx - 10} y={cy - 20} width="20" height="20" />
        <text class="m" x={dx} y={cy + 18} text-anchor="middle">{branch.cond}</text>
        <path class="edge" d={`M${dx + 24} ${cy - 24} C${dx + 68} ${cy - 62} ${dx + 88} ${cy - 68} ${outX - 4} ${cy - 68}`} marker-end={`url(#${uid})`} />
        <text class="m ok-t" x={dx + 62} y={cy - 62}>ja</text>
        <path class="edge" d={`M${dx + 24} ${cy + 24} C${dx + 68} ${cy + 62} ${dx + 88} ${cy + 68} ${outX - 4} ${cy + 68}`} marker-end={`url(#${uid})`} />
        <text class="m warn-t" x={dx + 62} y={cy + 76}>nee</text>
        {[{ n: branch.yes, y: cy - 68 - H / 2 }, { n: branch.no, y: cy + 68 - H / 2 }].map(({ n, y }) => (
          <g>
            <rect class={cls(n.tone)} x={outX} y={y} width={BW} height={H} rx="8" />
            <use href={`#i-${n.icon}`} class="ic" x={outX + 14} y={y + 18} width="20" height="20" />
            <text x={outX + 44} y={y + 24}>{n.title}</text>
            <text class="m" x={outX + 44} y={y + 42}>{n.sub}</text>
          </g>
        ))}
      </g>
    )}
  </svg>
</figure>
{note && <p class="figure-note">{note}</p>}
