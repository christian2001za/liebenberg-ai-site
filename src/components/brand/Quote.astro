---
/** Citaat: 26px, zonder kader of ornament. Alleen echte citaten met naam en functie. */
interface Props { name: string; role: string }
const { name, role } = Astro.props;
---
<figure class="quote">
  <blockquote><slot /></blockquote>
  <figcaption><b>{name}</b><span>{role}</span></figcaption>
</figure>
