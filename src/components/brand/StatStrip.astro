---
/** Cijferstrip: cijfers in mono, gescheiden door haarlijnen, label eronder. Cijfers staan er meteen. */
interface Props { items: { v: string; k: string; sub?: string }[]; note?: string; class?: string }
const { items, note, class: cls = "" } = Astro.props;
---
<div class={cls}>
  <dl class="stats" data-n={items.length} style={`--n:${items.length}`}>
    {items.map((s) => (
      <div class="stat"><dt class="k">{s.k}{s.sub && <span class="sub">{s.sub}</span>}</dt><dd class="v">{s.v}</dd></div>
    ))}
  </dl>
  {note && <p class="label stats-note">{note}</p>}
</div>
