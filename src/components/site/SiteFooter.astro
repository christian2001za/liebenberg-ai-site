---
/** Footer in de nieuwe stijl. WhatsApp staat hier en in het contactblok, nergens zwevend. */
import Logo from "../brand/Logo.astro";
import { WA, MAIL, PHONE, PHONE_HREF, LINKEDIN } from "../../lib/site";

const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div>
        <Logo />
        <p class="claim">Maatwerk AI-software voor bedrijven waar het werk groeit. Gebouwd in Amsterdam.</p>
      </div>
      <div class="cols">
        <div>
          <span class="label">Pagina</span>
          <a href={anchor("werk")}>Werk</a>
          <a href={anchor("over")}>Over</a>
          <a href={anchor("werkwijze")}>Werkwijze</a>
          <a href={anchor("vragen")}>Vragen</a>
          <a href={anchor("contact")}>Contact</a>
        </div>
        <div>
          <span class="label">Contact</span>
          <a href={`mailto:${MAIL}`}>{MAIL}</a>
          <a href={PHONE_HREF}>{PHONE}</a>
          <a href={WA}>WhatsApp</a>
          <a href={LINKEDIN}>LinkedIn</a>
        </div>
      </div>
    </div>
    <div class="bottom label">
      <span>© 2026 Liebenberg AI · KvK 98456598</span>
      <span><a href="/privacyverklaring">Privacyverklaring</a> · <a href="/algemene-voorwaarden">Algemene voorwaarden</a></span>
      <span>Schilderijen: Rijksmuseum (publiek domein)</span>
    </div>
  </div>
</footer>
