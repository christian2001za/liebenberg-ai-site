---
/**
 * Navigatie (BRAND §5): logo links, Werk · Werkwijze · Over · Vragen, primaire knop rechts.
 * Op de homepage zijn de links ankers; op subpagina's wijzen ze naar de homepage.
 * De balk plakt bovenaan: omlaag scrollen schuift hem weg, omhoog scrollen haalt hem terug.
 */
import Logo from "../brand/Logo.astro";
import Button from "../brand/Button.astro";
import { CAL } from "../../lib/site";

const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const links = [
  { id: "werk", label: "Werk" },
  { id: "over", label: "Over" },
  { id: "werkwijze", label: "Werkwijze" },
  { id: "vragen", label: "Vragen" },
];
---
<header class="site-nav" data-site-nav>
  <div class="wrap">
    <a class="logo-link" href="/" aria-label="Liebenberg AI, naar de homepage"><Logo /></a>
    <nav aria-label="Hoofdmenu">
      {links.map((l) => <a href={anchor(l.id)}>{l.label}</a>)}
    </nav>
    <Button href={CAL} size="sm">Plan een kennismaking</Button>
  </div>
</header>

<script>
  /*
   * Verbergen bij omlaag scrollen, tonen bij omhoog scrollen (het headroom-patroon):
   * twee toestanden, een kleine drempel per richting tegen trillen, en pas weg als je
   * voorbij de balk zelf bent. De beweging zelf is een CSS-overgang (zie .site-nav).
   */
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  if (nav) {
    const TOLERANCE = 8; // px in één richting voordat de balk wisselt
    let lastY = Math.max(0, window.scrollY);
    let run = 0; // opgetelde scroll in de huidige richting (+ omlaag, - omhoog)
    let ticking = false;

    const setHidden = (hidden: boolean) => nav.classList.toggle("is-hidden", hidden);

    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const dy = y - lastY;
      lastY = y;
      if (dy === 0) return;

      // Richting gewisseld: opnieuw beginnen met tellen.
      if ((dy > 0 && run < 0) || (dy < 0 && run > 0)) run = 0;
      run += dy;

      if (y <= nav.offsetHeight) setHidden(false); // bovenaan altijd zichtbaar
      else if (run > TOLERANCE && !nav.contains(document.activeElement)) setHidden(true);
      else if (run < -TOLERANCE) setHidden(false);
    };

    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    // Toetsenbord: met Tab in het menu komt de balk altijd terug.
    nav.addEventListener("focusin", () => setHidden(false));
  }
</script>
