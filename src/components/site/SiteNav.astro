---
/**
 * Navigatie (BRAND §5): logo links, Werk · Werkwijze · Over · Vragen, primaire knop rechts.
 * Op de homepage zijn de links ankers; op subpagina's wijzen ze naar de homepage.
 * De balk plakt bovenaan en schuift mee met het scrollen (zie het script onderaan).
 */
import Logo from "../brand/Logo.astro";
import Button from "../brand/Button.astro";
import { CAL } from "../../lib/site";

const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const links = [
  { id: "werk", label: "Werk" },
  { id: "over", label: "Over" },
  { id: "werkwijze", label: "Werkwijze" },
  { id: "vragen", label: "Vragen" },
];
---
<header class="site-nav" data-site-nav>
  <div class="wrap">
    <a class="logo-link" href="/" aria-label="Liebenberg AI, naar de homepage"><Logo /></a>
    <nav aria-label="Hoofdmenu">
      {links.map((l) => <a href={anchor(l.id)}>{l.label}</a>)}
    </nav>
    <Button href={CAL} size="sm">Plan een kennismaking</Button>
  </div>
</header>

<script>
  /*
   * De menubalk beweegt mee met het scrollen, niet met een timer: 10 px scrollen schuift de
   * balk 10 px. Langzaam scrollen is dus langzaam bewegen. Omhoog scrollen haalt hem op
   * dezelfde manier terug, waar je ook op de pagina bent. Stop je halverwege, dan glijdt
   * hij naar helemaal open of helemaal dicht, zodat hij nooit half blijft hangen.
   */
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  if (nav) {
    let lastY = Math.max(0, window.scrollY);
    let offset = 0; // 0 = helemaal zichtbaar, height = helemaal weg
    let height = nav.offsetHeight;
    let ticking = false;
    let idle = 0;

    const apply = () => { nav.style.transform = offset ? `translateY(${-offset}px)` : ""; };

    const snap = () => {
      if (offset === 0 || offset === height) return;
      nav.classList.add("is-snapping");
      offset = offset > height / 2 && window.scrollY > height ? height : 0;
      apply();
    };

    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const dy = y - lastY;
      lastY = y;
      nav.classList.remove("is-snapping");
      // Bovenaan de pagina altijd zichtbaar; anders meeschuiven met de scroll.
      offset = y <= 0 ? 0 : Math.min(height, Math.max(0, offset + dy));
      if (nav.contains(document.activeElement)) offset = 0;
      apply();
      clearTimeout(idle);
      idle = window.setTimeout(snap, 140);
    };

    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener("resize", () => { height = nav.offsetHeight; }, { passive: true });
    // Toetsenbord: met Tab in het menu komt de balk altijd helemaal terug.
    nav.addEventListener("focusin", () => { nav.classList.add("is-snapping"); offset = 0; apply(); });
  }
</script>
