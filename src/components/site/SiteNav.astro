---
/**
 * Navigatie (BRAND §5): logo links, Werk · Werkwijze · Over · Vragen, primaire knop rechts.
 * Op de homepage zijn de links ankers; op subpagina's wijzen ze naar de homepage.
 * De balk plakt bovenaan: naar beneden scrollen schuift hem weg, omhoog scrollen haalt hem
 * meteen terug, waar je ook op de pagina bent.
 */
import Logo from "../brand/Logo.astro";
import Button from "../brand/Button.astro";
import { CAL } from "../../lib/site";

const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
const links = [
  { id: "werk", label: "Werk" },
  { id: "over", label: "Over" },
  { id: "werkwijze", label: "Werkwijze" },
  { id: "vragen", label: "Vragen" },
];
---
<header class="site-nav" data-site-nav>
  <div class="wrap">
    <a class="logo-link" href="/" aria-label="Liebenberg AI, naar de homepage"><Logo /></a>
    <nav aria-label="Hoofdmenu">
      {links.map((l) => <a href={anchor(l.id)}>{l.label}</a>)}
    </nav>
    <Button href={CAL} size="sm">Plan een kennismaking</Button>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  if (nav) {
    let lastY = window.scrollY;
    let downRun = 0; // hoeveel px er achter elkaar naar beneden is gescrold
    let ticking = false;
    const HIDE_AFTER = 24; // pas weg na een echte beweging omlaag, niet bij elk trillertje

    const update = () => {
      ticking = false;
      const y = Math.max(0, window.scrollY);
      const dy = y - lastY;
      if (Math.abs(dy) < 3) return; // kleine trillingen negeren (trackpad)
      lastY = y;
      nav.classList.toggle("is-scrolled", y > 0);
      if (dy < 0) {
        // Omhoog: meteen terug, waar je ook op de pagina bent.
        downRun = 0;
        nav.classList.remove("is-hidden");
        return;
      }
      downRun += dy;
      if (downRun > HIDE_AFTER && y > nav.offsetHeight && !nav.contains(document.activeElement)) {
        nav.classList.add("is-hidden");
      }
    };

    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    // Toetsenbord: met Tab in het menu komt de balk altijd terug.
    nav.addEventListener("focusin", () => nav.classList.remove("is-hidden"));
  }
</script>
