---
import BrandLayout from "../layouts/BrandLayout.astro";
import "../styles/content.css";
---

<BrandLayout
  title="Pagina niet gevonden - Liebenberg AI"
  description="Pagina niet gevonden."
  canonical="https://www.liebenberg.ai/404"
  footer={false}
>
  <main class="page" style="min-height:70vh;display:flex;align-items:center;justify-content:center;text-align:center;">
    <div class="wrap" style="max-width:560px;">
      <p class="eyebrow" style="justify-content:center;">404</p>
      <h1 style="font-size:clamp(36px,5vw,58px);margin-top:16px;">Pagina niet gevonden</h1>
      <p class="lead" style="margin:18px auto 0;">De pagina die je zoekt bestaat niet of is verplaatst.</p>
      <div style="margin-top:32px;">
        <a class="btn btn-ink" href="/">Terug naar home</a>
      </div>
    </div>
  </main>
</BrandLayout>
