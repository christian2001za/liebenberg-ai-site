---
import BrandLayout from "../layouts/BrandLayout.astro";
import { Image } from "astro:assets";
import boot from "../assets/huisstijl/gravures/404.png";
import "../styles/content.css";
---

<BrandLayout
  title="Pagina niet gevonden - Liebenberg AI"
  description="Pagina niet gevonden."
  canonical="https://www.liebenberg.ai/404"
  footer={false}
>
  <main class="page page-404">
    <div class="wrap page-head">
      <Image class="gravure-404" src={boot} alt="" widths={[300, 600, 900]} sizes="300px" />
      <p class="label">404</p>
      <h1>Pagina niet gevonden</h1>
      <p class="lead">De pagina die je zoekt bestaat niet of is verplaatst.</p>
      <div>
        <a class="btn btn-primary" href="/">Terug naar home</a>
      </div>
    </div>
  </main>
</BrandLayout>
