---
import BrandLayout from "../layouts/BrandLayout.astro";
import "../styles/content.css";

const PDF = "/NLdigital-Voorwaarden-2025.pdf";
---

<BrandLayout
  title="Algemene Voorwaarden - Liebenberg AI"
  description="Op aanbiedingen en overeenkomsten van Liebenberg AI zijn de NLdigital Voorwaarden 2025 van toepassing."
  canonical="https://www.liebenberg.ai/algemene-voorwaarden"
>
  <main class="page">
    <article class="wrap">
      <div class="page-head">
        <p class="label">Juridisch</p>
        <h1>Algemene Voorwaarden</h1>
        <p class="lead">Op mijn aanbiedingen en overeenkomsten vanaf 16 oktober 2026 zijn de NLdigital Voorwaarden 2025 van toepassing, gedeponeerd bij de Rechtbank Midden-Nederland, locatie Utrecht. Je krijgt ze bij elke offerte mee.</p>
        <div class="row">
          <a class="btn btn-primary" href={PDF} download>Download de NLdigital Voorwaarden 2025 <span class="arr" aria-hidden="true">↓</span></a>
          <span class="label">PDF · 22 pagina's</span>
        </div>
      </div>
    </article>
  </main>
</BrandLayout>
