---
import BrandLayout from "../../layouts/BrandLayout.astro";
import "../../styles/content.css";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BrandLayout
  title="Blog | Liebenberg AI"
  description="Praktische inzichten over AI, automatisering en slimme software voor consultancy en MKB."
  canonical="https://www.liebenberg.ai/blog/"
>
  <main class="page">
    <div class="wrap">
      <div class="page-head">
        <p class="label">Blog</p>
        <h1>Inzichten en praktijkvoorbeelden</h1>
        <p class="lead">Artikelen over AI-toepassingen, procesoptimalisatie en hoe je dit slim inzet in consultancy en het MKB.</p>
      </div>

      {posts.length === 0 ? (
        <div class="empty-card">Nog geen artikelen gepubliceerd.</div>
      ) : (
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="post-card">
              {post.data.heroImage ? (
                <img src={post.data.heroImage} alt={post.data.title} class="thumb" loading="lazy" />
              ) : (
                <div class="thumb"></div>
              )}
              <div>
                <p class="meta">
                  {post.data.pubDate.toLocaleDateString("nl-NL", { year: "numeric", month: "long", day: "numeric" })}
                </p>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </main>
</BrandLayout>
