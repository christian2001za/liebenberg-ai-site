---
import AutoVideo from "../components/brand/AutoVideo.astro";
import BrandLayout from "../layouts/BrandLayout.astro";
import Button from "../components/brand/Button.astro";
import Icon from "../components/brand/Icon.astro";
import Stage from "../components/brand/Stage.astro";
import StatStrip from "../components/brand/StatStrip.astro";
import CaseRow from "../components/brand/CaseRow.astro";
import Quote from "../components/brand/Quote.astro";
import ProductLoop from "../components/brand/ProductLoop.astro";
import ContactBlock from "../components/brand/ContactBlock.astro";
import Koppelingen from "../components/brand/Koppelingen.astro";
import "../styles/home.css";
import { Image } from "astro:assets";
import portrait from "../assets/LiebenbergAI_portrait_Christian.jpeg";
import stilAlgemeen from "../assets/huisstijl/stillevens/algemeen-stilleven.jpg";
import stilWerkwijze from "../assets/huisstijl/stillevens/werkwijze-stilleven-16x9.jpg";
import { CAL, LINKEDIN } from "../lib/site";
import heroPainting from "../assets/huisstijl/schilderijen/mesdag-kalme-zee.jpg?url";

const HOORNAAR_CASE = "/case-study/meldpunt-aziatische-hoornaar/";
const HOORNAAR_LIVE = "https://www.meldpuntaziatischehoornaar.nl";

// De FAQ staat hier één keer en voedt zowel het FAQPage-schema als de sectie hieronder.
const faqItems = [
  {
    q: "Wat kost het om AI-software of een AI-tool te laten bouwen?",
    a: ["Dat hangt af van wat er nodig is. Na de werksessie en de demo krijg je een vaste prijs per fase, voordat we beginnen."],
  },
  {
    q: "Vervangt dit mijn mensen?",
    a: ["Nee. Het systeem doet het werk dat regels volgt; je mensen houden het oordeel. Zo neem je met dezelfde mensen meer klussen aan."],
  },
  {
    q: "Er bestaat toch al software voor mijn branche?",
    a: ["Vaak wel, en past het, gebruik het dan. Ik kom pas in beeld als je Excel ernaast laat lopen of dingen overtypt."],
  },
  {
    q: "Werkt dit met de software die ik nu al gebruik?",
    a: ["Ja. Ik koppel het aan de systemen waar je al in werkt, zoals je mail, planning, boekhouding of CRM. Heeft een pakket geen koppeling, dan zoek ik een andere weg, bijvoorbeeld via een export."],
  },
  {
    q: "Wat gebeurt er met mijn software als jij er straks mee zou stoppen?",
    a: ["Dan draait alles door. Het staat op jouw naam en een andere ontwikkelaar kan het overnemen."],
  },
  {
    q: "Is mijn data veilig als ik AI gebruik?",
    a: ["Ja. Europese hosting, een verwerkersovereenkomst, en je data wordt nooit gebruikt om modellen te trainen."],
  },
  {
    q: "Kan AI dit al betrouwbaar, of is het nog speelgoed?",
    a: ["Voor werk dat regels volgt wel. Ik meet hoe vaak het systeem goed zit en stuur alles waar het twijfelt naar een mens."],
  },
  {
    q: "Hoe lang duurt het voordat ik iets werkends heb?",
    a: ["De demo zie je binnen ongeveer een week na de werksessie. Daarna levert elke fase iets bruikbaars op."],
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.join(" ") },
  })),
};

const proof = [
  { v: "3.500+", k: "Accounts op software van Liebenberg AI" },
  { v: "EU", k: "Europees gehost", sub: "GDPR/AVG compliant" },
  { v: "MSc", k: "Econometrie" },
];

const hoornaarStats = [
  { v: "3.500+", k: "Accounts" },
  { v: "35.000+", k: "Meldingen" },
  { v: "#1", k: "Organisch" },
  { v: "AI Overview", k: "Aangeraden in Google's AI Overview" },
];

const builds = [
  { icon: "melding", t: "Aanvragen die alle kanten op binnenkomen", p: "Mail, WhatsApp, foto's, een voicememo. Het systeem leest ze en zet alles klaar in één scherm." },
  { icon: "maken", t: "Offertes en planningen die per klus anders zijn", p: "Het systeem maakt het concept op basis van jouw prijzen. Jij kijkt het na." },
  { icon: "koppeling", t: "Systemen die niet met elkaar praten", p: "Planning, boekhouding en CRM aan elkaar, inclusief de stap die nu iemand doet." },
  { icon: "controle", t: "Controles die nu iemand een dag kosten", p: "Het systeem doet de eerste ronde. Jij ziet alleen de twijfelgevallen." },
] as const;

const steps = [
  { t: "Werksessie", p: "In een uur tekenen we uit hoe het werk nu loopt. Liefst met degene die het nu doet." },
  { t: "Demo en voorstel", p: "Daarna een werkende demo op jouw proces, met een vaste prijs en planning. Tot hier kost het niets." },
  { t: "Bouwen in fases", p: "Eén proces of een heel platform, in fases met een vaste prijs. Geen uurtje-factuurtje." },
  { t: "Daarna", p: "Ik houd het draaiend en bouw door. Het draait op jouw naam, dus verder met een ander kan altijd." },
];
---

<BrandLayout
  title="Liebenberg AI | Ik automatiseer het werk dat tot vandaag alleen een mens kon doen"
  description="Maatwerk AI-software voor bedrijven waar het werk groeit en de administratie niet meekan. Eerst een werkende demo op je eigen proces, met een vaste prijs vooraf."
  canonical="https://www.liebenberg.ai/"
  schema={[faqSchema]}
>
  <link slot="head" rel="preload" as="image" href={heroPainting} fetchpriority="high" />
  <main>
    <!-- 1. Hero -->
    <section class="hero" aria-labelledby="hero-kop">
      <div class="wrap">
        <div class="hero-txt">
          <a class="live" href={HOORNAAR_LIVE}><i aria-hidden="true"></i>Live: Meldpunt Aziatische Hoornaar</a>
          <h1 class="t-display" id="hero-kop">Ik automatiseer het werk dat tot vandaag alleen een mens kon doen.</h1>
          <p class="t-lead">Maatwerk AI-software voor bedrijven waar het werk groeit en de administratie niet meekan. Meldingen, aanvragen, werkbonnen en planningen die nu nog met de hand gaan.</p>
          <div class="row">
            <Button href={CAL} arrow>Plan een kennismaking</Button>
            <Button href={HOORNAAR_CASE} variant="secondary">Bekijk de Hoornaar-case</Button>
          </div>
        </div>

        <ProductLoop />

        <!-- 2. Bewijs -->
        <StatStrip class="hero-stats" items={proof} />
      </div>
    </section>

    <!-- 3. Voor wie -->
    <section class="section" aria-labelledby="voorwie-kop">
      <div class="wrap split">
        <div class="voorwie-side">
          <h2 class="t-h2" id="voorwie-kop">Voor wie dit is.</h2>
          <Image class="stilleven" src={stilAlgemeen} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 360px" loading="lazy" />
        </div>
        <div class="prose-block">
          <p class="t-lead">Denk aan bestrijders, verhuurbedrijven, installateurs en transporteurs. De aanvragen komen binnen via mail, WhatsApp en de telefoon, en iemand op kantoor typt ze over. Zolang dat met de hand gaat, groeit je bedrijf zo hard als die persoon kan typen.</p>
          <p class="big-line">Als je volgende maand twee keer zoveel aanvragen kreeg, wie zou ze dan verwerken?</p>
        </div>
      </div>
    </section>

    <!-- 4. Kernblok -->
    <section class="section" aria-labelledby="kern-kop">
      <div class="wrap split">
        <div><h2 class="t-h2" id="kern-kop">De stap waar altijd iemand bij moest nadenken.</h2></div>
        <div class="prose-block">
          <p class="kern-txt">Een aanvraag via WhatsApp met drie foto's. Een offerte die per klant anders is. Gewone software liep daar vast, want er moest iemand lezen en beslissen. Ik bouw software die dat werk overneemt, en je ziet wat het systeem zelf besliste en wat het aan jou laat.</p>
        </div>
      </div>
    </section>

    <!-- 5. Uitgelichte case: Hoornaar -->
    <section class="section" id="werk" aria-labelledby="hoornaar-kop">
      <div class="wrap feat">
        <div class="section-head">
          <span class="label">Platform · Bestrijding · Live</span>
          <h2 id="hoornaar-kop">Het platform waar zijn bedrijf op draait.</h2>
          <p>Rob Voesten bestrijdt de geelpoothoornaar voor gemeenten. Zijn werk liep via Word, Excel en losse mailtjes. Nu loopt alles door één platform, van melding tot uitvoerder tot factuur. Zonder dat platform zou hij de vraag niet aankunnen.</p>
        </div>
        <Stage painting="warm">
          <div class="app">
            <AutoVideo
              src="/video/hoornaar-case.mp4"
              poster="/video/hoornaar-case-poster.jpg"
              width={1280}
              height={720}
              label="Video: hoe het Meldpunt Aziatische Hoornaar van Word en Excel naar één platform ging"
            />
          </div>
        </Stage>
        <StatStrip items={hoornaarStats} />
        <Quote name="Rob Voesten" role="Oprichter, NatuurlijkRob">"Hele fijne samenwerking. Er wordt goed geluisterd, verzoeken worden snel opgepakt en het platform groeit met ons mee."</Quote>
        <div class="row" style="gap:24px">
          <Button href={HOORNAAR_CASE} arrow>Lees de case study</Button>
          <Button href={HOORNAAR_LIVE} variant="link" arrow>Bekijk het platform live</Button>
        </div>
      </div>
    </section>

    <!-- 8. Over -->
    <section class="section" id="over" aria-labelledby="over-kop">
      <div class="wrap about">
        <Image src={portrait} alt="Portret van Christian Liebenberg" widths={[400, 720]} sizes="(max-width: 900px) 360px, 420px" loading="lazy" />
        <div class="txt">
          <span class="label">Over</span>
          <h2 id="over-kop">Ik bouw het, en ik blijf erbij.</h2>
          <p>Ik ben Christian. Ik bouw maatwerksoftware voor bedrijven waarvan het werk niet in een standaardpakket past. Soms zit daar AI in, vaak is het gewoon goede software.</p>
          <p>Ik heb econometrie gestudeerd en toetste daarna risicomodellen voor banken. Daar leerde ik niets aan te nemen voordat het is nagerekend.</p>
          <p>Je hebt één vast aanspreekpunt. Als er iets is, bel of app je gewoon.</p>
          <dl class="facts">
            <div><dt class="label">Opleiding</dt><dd>MSc Econometrie</dd></div>
            <div><dt class="label">Eerder</dt><dd>Zanders (ING, bunq)</dd></div>
            <div><dt class="label">Kantoor</dt><dd>Amsterdam</dd></div>
          </dl>
          <div><Button href={LINKEDIN} variant="link" arrow>Connect op LinkedIn</Button></div>
        </div>
      </div>
    </section>

    <!-- 6. Wat ik bouw -->
    <section class="section" aria-labelledby="bouw-kop">
      <div class="wrap">
        <div class="section-head">
          <h2 id="bouw-kop">Wat ik bouw.</h2>
          <p>Vier soorten werk waar gewone software altijd op vastliep.</p>
        </div>
        <ul class="items two">
          {builds.map((b) => (
            <li><Icon name={b.icon} /><h3>{b.t}</h3><p>{b.p}</p></li>
          ))}
        </ul>
        <Koppelingen />
      </div>
    </section>

    <!-- 7. Hoe het werkt -->
    <section class="section" id="werkwijze" aria-labelledby="werkwijze-kop">
      <div class="wrap">
        <div class="werkwijze-head">
          <div class="section-head">
            <h2 id="werkwijze-kop">Hoe het werkt.</h2>
            <p>Je ziet iets werkends op je eigen proces, met een vaste prijs erbij, voordat je iets betaalt.</p>
          </div>
          <Image class="stilleven stilleven-breed" src={stilWerkwijze} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 360px" loading="lazy" />
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="label">{i + 1}</span><h3>{s.t}</h3><p>{s.p}</p></li>
          ))}
        </ol>
        <div class="row" style="margin-top:40px"><Button href={CAL} arrow>Plan een kennismaking</Button></div>
      </div>
    </section>

    <!-- 9. Meer cases -->
    <section class="section" aria-labelledby="cases-kop">
      <div class="wrap">
        <div class="section-head"><h2 id="cases-kop">Meer cases.</h2></div>
        <div class="cases">
          <CaseRow gravure="evenementen" href="/case-study/ai-sales-evenementenbranche/" label="Platform · Evenementenverhuur · In ontwikkeling, oplevering Q4 2026" title="Een AI-CRM dat leads vindt en benadert in de evenementenbranche.">
            Vindt evenementen en hun organisatoren, benadert ze op het goede moment en regelt de boeking.
          </CaseRow>
          <CaseRow gravure="eye-motion-lab" href="/case-study/imotion-lab-erp/" label="Platform · Oogzorg · Live" title="Het ERP waar een oogzorgbedrijf op draait.">
            Bestellingen, dossiers, bezorging en facturatie in één systeem, omdat geen pakket paste.
          </CaseRow>
        </div>
      </div>
    </section>

    <!-- 10. Vragen -->
    <section class="section" id="vragen" aria-labelledby="vragen-kop">
      <div class="wrap split">
        <div><h2 class="t-h2" id="vragen-kop">Vragen.</h2></div>
        <div class="faq">
          {faqItems.map((item, i) => (
            <details open={i === 0}>
              <summary><span>{item.q}</span><span class="pm" aria-hidden="true"></span></summary>
              <div class="ans">{item.a.map((p) => <p>{p}</p>)}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 11. Contact -->
    <ContactBlock />
  </main>
</BrandLayout>
