---
import AutoVideo from "../components/brand/AutoVideo.astro";
import BrandLayout from "../layouts/BrandLayout.astro";
import Button from "../components/brand/Button.astro";
import Icon from "../components/brand/Icon.astro";
import Stage from "../components/brand/Stage.astro";
import StatStrip from "../components/brand/StatStrip.astro";
import CaseRow from "../components/brand/CaseRow.astro";
import Quote from "../components/brand/Quote.astro";
import ProductLoop from "../components/brand/ProductLoop.astro";
import ContactBlock from "../components/brand/ContactBlock.astro";
import "../styles/home.css";
import { Image } from "astro:assets";
import portrait from "../assets/LiebenbergAI_portrait_Christian.jpeg";
import office from "../assets/LAI_kantoor.jpg";
import stilAlgemeen from "../assets/huisstijl/stillevens/algemeen-stilleven.jpg";
import stilWerkwijze from "../assets/huisstijl/stillevens/werkwijze-stilleven.jpg";
import { CAL, LINKEDIN } from "../lib/site";
import heroPainting from "../assets/huisstijl/schilderijen/mesdag-kalme-zee.jpg?url";

const HOORNAAR_CASE = "/case-study/meldpunt-aziatische-hoornaar/";
const HOORNAAR_LIVE = "https://www.meldpuntaziatischehoornaar.nl";

// De FAQ staat hier één keer en voedt zowel het FAQPage-schema als de sectie hieronder.
const faqItems = [
  {
    q: "Hoe ziet de eerste stap eruit?",
    a: ["We beginnen met een werksessie van een uur. Daarin tekenen we uit hoe het werk nu loopt en waar het vastzit. Het liefst zit daar ook degene bij die het werk nu doet, want die weet waar het in de praktijk misgaat. Daarna kom ik terug met een werkende demo op jouw eigen proces en een voorstel met de kosten, de termijnen en wat je precies krijgt. Tot dan kost het je niets, en je zit nergens aan vast."],
  },
  {
    q: "Wat kost het om AI-software of een AI-tool te laten bouwen?",
    a: ["Dat hangt af van wat er nodig is: één proces met een eigen scherm is iets anders dan het platform waar je bedrijf op draait. Daarom begin ik met een werksessie en een werkende demo op jouw proces, zonder kosten. Daarna krijg je een voorstel met een vaste prijs per fase, die je kent voordat we beginnen. Geen uurtje-factuurtje, en je ziet resultaat voordat je verder gaat."],
  },
  {
    q: "Vervangt dit mijn mensen?",
    a: ["Nee. De AI neemt het werk over dat vaste regels volgt. Je mensen houden het werk dat oordeel vraagt en blijven de eindcontrole. Het effect is dat je met dezelfde mensen meer klussen aanneemt. In een arbeidsmarkt waar nieuwe mensen nauwelijks te vinden zijn, is dat meestal precies wat nodig is."],
  },
  {
    q: "Er bestaat toch al software voor mijn branche?",
    a: ["Vaak wel, en als zo'n pakket jullie proces dekt, moet je dat gewoon gebruiken. Dan ben ik te duur. Ik kom pas in beeld als jullie manier van werken er net niet in past: als je overal Excel naast laat lopen, dingen overtypt omdat het pakket het niet kan, of een koppeling mist. Het gaat erom of jullie werkelijke proces erin past."],
  },
  {
    q: "Werkt dit met de software die ik nu al gebruik?",
    a: ["Ja, en daar zit de waarde. Ik koppel het aan de systemen waar je al in werkt, zoals je planning, je boekhouding of je CRM. Je mensen blijven in hun eigen schermen werken."],
  },
  {
    q: "Heb ik een eigen IT-afdeling of technische kennis nodig?",
    a: ["Nee. Ik regel alles, van de bouw tot hosting en doorontwikkeling, met één aanspreekpunt. Jij houdt de regie over je proces en je data."],
  },
  {
    q: "Wat gebeurt er met mijn software als jij er straks mee zou stoppen?",
    a: ["Dan draait alles gewoon door. Hosting, database en domein staan op jouw naam, en een andere ontwikkelaar kan het overnemen. Je data is van jou en altijd te exporteren."],
  },
  {
    q: "Is mijn data veilig als ik AI gebruik?",
    a: [
      "Ja. Ik ben GDPR/AVG compliant en werk met Europese hosting, een verwerkersovereenkomst, en je data wordt nooit gebruikt om modellen te trainen. Toegang is rolgebaseerd, output is traceerbaar naar de bron, en er is menselijk toezicht ingebouwd waar dat nodig is.",
      "Ik beheer de infrastructuur, jij beheert de inhoud. Net als bij je huidige cloud-boekhoudpakket.",
    ],
  },
  {
    q: "Kan AI dit al betrouwbaar, of is het nog speelgoed?",
    a: ["Het hangt af van welk deel van het werk je de AI geeft. Het werk dat regels volgt kan AI inmiddels betrouwbaar aan, het oordeel hoort bij de mens. Een losse chatbot die alles tegelijk probeert is speelgoed, een systeem dat die scheiding respecteert en gemeten wordt niet. Vanuit mijn econometrische achtergrond toets ik hoe accuraat en betrouwbaar de output is, met aandacht voor hallucinatie en bronvermelding, en bouw ik menselijk toezicht in waar fouten niet mogen. Daardoor weet je wanneer je het kunt vertrouwen, in plaats van het te hopen."],
  },
  {
    q: "Hoe lang duurt het voordat ik iets werkends heb?",
    a: ["Ik werk in afgeronde fases die elk een bruikbaar resultaat opleveren, in plaats van maandenlang bouwen zonder dat je iets ziet. Je hebt dus snel iets werkends in handen, en je ziet steeds resultaat voordat je verder gaat."],
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.join(" ") },
  })),
};

const proof = [
  { v: "3.500+", k: "Accounts op software van Liebenberg AI" },
  { v: "EU", k: "Europees gehost", sub: "GDPR/AVG compliant" },
  { v: "MSc", k: "Econometrie" },
];

const hoornaarStats = [
  { v: "3.500+", k: "Accounts" },
  { v: "35.000+", k: "Meldingen" },
  { v: "#1", k: "Organisch" },
  { v: "AI Overview", k: "Aangeraden in Google's AI Overview" },
];

const builds = [
  { icon: "melding", t: "Aanvragen die alle kanten op binnenkomen", p: "Mail, WhatsApp, formulieren, foto's, een voicememo. Het systeem leest ze, haalt eruit wat nodig is en zet alles klaar in één scherm, waar jij het controleert en doorzet." },
  { icon: "maken", t: "Offertes en planningen die per klus anders zijn", p: "Het systeem maakt het concept op basis van jouw prijzen en regels. Jij kijkt het na en verstuurt." },
  { icon: "koppeling", t: "Systemen die niet met elkaar praten", p: "Je planning, je boekhouding en je CRM aan elkaar, inclusief de stap die nu iemand doet: indelen en toewijzen." },
  { icon: "controle", t: "Controles die nu iemand een dag kosten", p: "Het systeem doet de eerste ronde en legt uit waarom. Jij ziet alleen de twijfelgevallen." },
] as const;

const steps = [
  { t: "Werksessie", p: "In een uur tekenen we samen uit hoe het werk nu loopt en waar het vastzit. Met jou, en liefst met degene die het werk nu doet, want die weet waar het in de praktijk misgaat." },
  { t: "Demo en voorstel", p: "Daarna kom ik terug met een werkende demo op jouw eigen proces, en een voorstel met wat het kost, hoe lang het duurt en wat je precies krijgt. Tot hier kost het je niets." },
  { t: "Bouwen in fases", p: "Eén proces met een eigen scherm, of het platform waar je hele bedrijf op draait. Elke fase heeft een vaste prijs die je vooraf kent, en je gebruikt het resultaat voordat we verder gaan. Uurtje-factuurtje doe ik niet." },
  { t: "Daarna", p: "Ik houd het draaiend, los op wat stuk gaat en bouw door op wat je nodig hebt. Wil je het onderhoud later zelf doen of bij een ander beleggen, dan kan dat." },
];
---

<BrandLayout
  title="Liebenberg AI | Ik automatiseer het werk dat tot vandaag alleen een mens kon doen"
  description="Maatwerk AI-software voor bedrijven waar het werk groeit en de administratie niet meekan. Eerst een werkende demo op je eigen proces, met een vaste prijs vooraf."
  canonical="https://www.liebenberg.ai/"
  schema={[faqSchema]}
>
  <link slot="head" rel="preload" as="image" href={heroPainting} fetchpriority="high" />
  <main>
    <!-- 1. Hero -->
    <section class="hero" aria-labelledby="hero-kop">
      <div class="wrap">
        <div class="hero-txt">
          <a class="live" href={HOORNAAR_LIVE}><i aria-hidden="true"></i>Live: Meldpunt Aziatische Hoornaar</a>
          <h1 class="t-display" id="hero-kop">Ik automatiseer het werk dat tot vandaag alleen een mens kon doen.</h1>
          <p class="t-lead">Maatwerk AI-software voor bedrijven waar het werk groeit en de administratie niet meekan. Meldingen, aanvragen, werkbonnen en planningen die nu nog met de hand gaan. Eén aanspreekpunt, van eerste gesprek tot doorontwikkeling.</p>
          <div class="row">
            <Button href={CAL} arrow>Plan een kennismaking</Button>
            <Button href={HOORNAAR_CASE} variant="secondary">Bekijk de Hoornaar-case</Button>
          </div>
        </div>

        <ProductLoop />

        <!-- 2. Bewijs -->
        <StatStrip class="hero-stats" items={proof} />
      </div>
    </section>

    <!-- 3. Voor wie -->
    <section class="section" aria-labelledby="voorwie-kop">
      <div class="wrap split">
        <div class="voorwie-side">
          <h2 class="t-h2" id="voorwie-kop">Voor wie dit is.</h2>
          <Image class="stilleven" src={stilAlgemeen} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 360px" loading="lazy" />
        </div>
        <div class="prose-block">
          <p>Denk aan bestrijders, verhuurbedrijven, installateurs en transporteurs. Bedrijven waar het werk buiten gebeurt, in het veld of in het magazijn. De aanvragen komen binnen via mail, WhatsApp en de telefoon, en iemand op kantoor typt ze over, plant ze in en zet de factuur klaar. Zolang dat met de hand gaat, groeit je bedrijf zo hard als die persoon kan typen.</p>
          <p class="big-line">Als je volgende maand twee keer zoveel aanvragen kreeg, wie zou ze dan verwerken?</p>
        </div>
      </div>
    </section>

    <!-- 4. Kernblok -->
    <section class="section" aria-labelledby="kern-kop">
      <div class="wrap split">
        <div><h2 class="t-h2" id="kern-kop">De stap waar altijd iemand bij moest nadenken.</h2></div>
        <div class="prose-block">
          <p>In elk bedrijf zit werk dat nooit te automatiseren was, omdat er iemand moest lezen, beoordelen of beslissen voordat er iets kon gebeuren. Een aanvraag via WhatsApp met drie foto's en een adres. Een offerte die per klant anders is. Een controle die altijd door een mens ging. Gewone software liep daar vast: die doet precies wat je programmeert en kan niets met een rommelig bericht of een oordeel dat per geval verschilt.</p>
          <p>Dat kan nu wel. Ik bouw software die dat lees- en beoordeelwerk overneemt, en ik bouw het zo dat je ziet wat het systeem zelf besliste en wat het aan jou laat. Jij blijft de eindcontrole. Daardoor neem je meer klussen aan zonder er iemand bij te zetten.</p>
        </div>
      </div>
    </section>

    <!-- 5. Uitgelichte case: Hoornaar -->
    <section class="section" id="werk" aria-labelledby="hoornaar-kop">
      <div class="wrap feat">
        <div class="section-head">
          <span class="label">Platform · Bestrijding · Live</span>
          <h2 id="hoornaar-kop">Het platform waar zijn bedrijf op draait.</h2>
          <p>Rob Voesten bestrijdt de geelpoothoornaar voor gemeenten. Zijn werk liep via Word, Excel en losse mailtjes. Nu loopt alles door één platform, van melding tot uitvoerder tot factuur. Zonder dat platform zou hij de vraag niet aankunnen.</p>
        </div>
        <Stage painting="warm">
          <div class="app">
            <AutoVideo
              src="/video/hoornaar-case.mp4"
              poster="/video/hoornaar-case-poster.jpg"
              width={1280}
              height={720}
              label="Video: hoe het Meldpunt Aziatische Hoornaar van Word en Excel naar één platform ging"
            />
          </div>
        </Stage>
        <StatStrip items={hoornaarStats} />
        <Quote name="Rob Voesten" role="Oprichter, NatuurlijkRob">"Hele fijne samenwerking. Er wordt goed geluisterd, verzoeken worden snel opgepakt en het platform groeit met ons mee."</Quote>
        <div class="row" style="gap:24px">
          <Button href={HOORNAAR_CASE} arrow>Lees de case study</Button>
          <Button href={HOORNAAR_LIVE} variant="link" arrow>Bekijk het platform live</Button>
        </div>
      </div>
    </section>

    <!-- 8. Over -->
    <section class="section" id="over" aria-labelledby="over-kop">
      <div class="wrap about">
        <Image src={portrait} alt="Portret van Christian Liebenberg" widths={[400, 720]} sizes="(max-width: 900px) 360px, 420px" loading="lazy" />
        <div class="txt">
          <span class="label">Over</span>
          <h2 id="over-kop">Ik bouw het, en ik blijf erbij.</h2>
          <p>Ik ben Christian. Ik bouw maatwerksoftware voor bedrijven waarvan het werk niet in een standaardpakket past: de planning, de aanvragen en de administratie waar het bedrijf op draait. Soms zit daar AI in, vaak is het gewoon goede software die doet wat hij moet doen.</p>
          <p>Ik heb econometrie gestudeerd en werkte daarna als risk consultant bij Zanders, aan modellen voor onder meer ING en bunq. Daar heb ik geleerd om niets aan te nemen voordat het is nagerekend. Dat doe ik nu met de software die ik bouw.</p>
          <p>Je hebt één vast aanspreekpunt, en als er iets is, bel of app je gewoon. De software draait op jouw naam en je data is van jou.</p>
          <dl class="facts">
            <div><dt class="label">Opleiding</dt><dd>MSc Econometrie</dd></div>
            <div><dt class="label">Eerder</dt><dd>Risk consultant bij Zanders, voor onder meer ING en bunq</dd></div>
            <div><dt class="label">Kantoor</dt><dd>Amsterdam</dd></div>
          </dl>
          <div><Button href={LINKEDIN} variant="link" arrow>Connect op LinkedIn</Button></div>
        </div>
      </div>
    </section>

    <!-- 6. Wat ik bouw -->
    <section class="section" aria-labelledby="bouw-kop">
      <div class="wrap">
        <div class="section-head">
          <h2 id="bouw-kop">Wat ik bouw.</h2>
          <p>Vier soorten werk waar gewone software altijd op vastliep.</p>
        </div>
        <ul class="items two">
          {builds.map((b) => (
            <li><Icon name={b.icon} /><h3>{b.t}</h3><p>{b.p}</p></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. Hoe het werkt -->
    <section class="section" id="werkwijze" aria-labelledby="werkwijze-kop">
      <div class="wrap">
        <div class="werkwijze-head">
          <div class="section-head">
            <h2 id="werkwijze-kop">Hoe het werkt.</h2>
            <p>Je ziet iets werkends op je eigen proces, met een vaste prijs erbij, voordat je iets betaalt.</p>
          </div>
          <Image class="stilleven" src={stilWerkwijze} alt="" widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 460px" loading="lazy" />
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li><span class="label">{i + 1}</span><h3>{s.t}</h3><p>{s.p}</p></li>
          ))}
        </ol>
        <div class="row" style="margin-top:40px"><Button href={CAL} arrow>Plan een kennismaking</Button></div>

        <!-- 7b. Je zit niet aan mij vast -->
        <div class="not-stuck">
          <h3 class="t-h3">Je zit niet aan mij vast.</h3>
          <p>Je data blijft van jou en de software draait op jouw naam. Wil je ooit verder met een ander, dan kan dat.</p>
        </div>
      </div>
    </section>

    <!-- 9. Meer cases -->
    <section class="section" aria-labelledby="cases-kop">
      <div class="wrap">
        <div class="section-head"><h2 id="cases-kop">Meer cases.</h2></div>
        <div class="cases">
          <CaseRow gravure="evenementen" href="/case-study/ai-sales-evenementenbranche/" label="Platform · Evenementenverhuur · In ontwikkeling, oplevering Q4 2026" title="De juiste evenementen, op het juiste moment.">
            Voor een verhuurbedrijf in de evenementenbranche vindt het systeem de relevante evenementen, de organisatoren erachter en hun contactgegevens, uit het hele web en uit vergunningsaanvragen. Het benadert ze op het juiste moment en volgt op. Daarna lopen offertes, boekingen en facturatie door hetzelfde systeem.
          </CaseRow>
          <CaseRow gravure="eye-motion-lab" href="/case-study/imotion-lab-erp/" label="Platform · Oogzorg · Live" title="Het ERP waar een oogzorgbedrijf op draait.">
            Een eigen ERP en praktijkportaal voor Eye Motion Lab. Bestellingen, patiëntdossiers, bezorging, facturatie en boekhouding lopen in één flow, van inlog tot geplaatste order. Gebouwd omdat er geen pakket bestond dat bij hun proces paste.
          </CaseRow>
        </div>
      </div>
    </section>

    <!-- 10. Vragen -->
    <section class="section" id="vragen" aria-labelledby="vragen-kop">
      <div class="wrap split">
        <div><h2 class="t-h2" id="vragen-kop">Vragen.</h2></div>
        <div class="faq">
          {faqItems.map((item, i) => (
            <details open={i === 0}>
              <summary><span>{item.q}</span><span class="pm" aria-hidden="true"></span></summary>
              <div class="ans">{item.a.map((p) => <p>{p}</p>)}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 11. Contact -->
    <ContactBlock>
      <Image slot="photo" src={office} alt="Het kantoor van Liebenberg AI in Amsterdam, met het logo op de muur" widths={[480, 800]} sizes="(max-width: 900px) 100vw, 420px" loading="lazy" />
    </ContactBlock>
  </main>
</BrandLayout>
