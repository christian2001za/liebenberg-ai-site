---
import BrandLayout from "../../layouts/BrandLayout.astro";
import "../../styles/content.css";

const tools = [
  {
    title: "AI-scan",
    description:
      "Een gesprek van tien minuten dat uitzoekt waar in jouw bedrijf AI het snelst iets oplevert — en waar niet. Praten mag, typen ook.",
    href: "/ai-scan/",
    cta: "Start de scan",
  },
  {
    title: "AI Humanizer",
    description:
      "Plak AI-gegenereerde tekst en krijg een natuurlijkere, menselijkere versie terug. Gratis, zonder account.",
    href: "/tools/humanizer/",
    cta: "Open tool",
  },
];
---

<BrandLayout
  title="Tools — Liebenberg AI"
  description="Gratis AI-tools van Liebenberg AI. Praktische hulpmiddelen voor het werken met taalmodellen, geen account vereist."
  canonical="https://www.liebenberg.ai/tools/"
>
  <main class="page page-wide">
    <div class="wrap">
      <div class="page-head">
        <p class="eyebrow">Tools</p>
        <h1>Gratis AI-tools.</h1>
        <p class="lead">Kleine, praktische hulpmiddelen die we zelf gebruiken. Geen account, geen gedoe — open en gebruiken.</p>
      </div>

      <div class="tool-grid">
        {tools.map((tool) => (
          <a href={tool.href} class="tool-card">
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <span class="link-arrow">{tool.cta} <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h9M9 4l4 4-4 4"></path></svg></span>
          </a>
        ))}
      </div>
    </div>
  </main>
</BrandLayout>
